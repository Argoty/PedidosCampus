NODE_ENV=development
PORT=3001

# Para ejecutar el microservicio con npm (sin Docker para la app)
# usando PostgreSQL local instalado en tu maquina.
AUTH_DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db?schema=public

# Secrets JWT (cambialos en tu entorno real)
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=10

# En local HTTP usar false. En produccion debe ser true.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Inter-service URLs and auth
USER_SERVICE_URL=http://localhost:5000
SERVICE_TOKEN=internal_super_secret_token_123
