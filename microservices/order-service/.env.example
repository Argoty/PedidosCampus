# Order Service Configuration
# Copy this to .env and fill with your local values

# Server
SERVER_PORT=8002
SERVER_ENV=development

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/pedidos_db?sslmode=disable
DATABASE_LOG_LEVEL=info

# JWT
JWT_SECRET=your-secret-key-change-in-production

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=orders
RABBITMQ_QUEUE_PREFIX=order-service

# User Service (for validation)
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_TIMEOUT=5s

# Restaurant Service (for validation)
RESTAURANT_SERVICE_URL=http://localhost:3002
RESTAURANT_SERVICE_TIMEOUT=5s

# Delivery Cost (in cents or base units)
DELIVERY_COST=200

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Internal Services
NOTIFICACIONES_SERVICE_URL=http://localhost:8787
SERVICE_TOKEN=internal_super_secret_token_123
