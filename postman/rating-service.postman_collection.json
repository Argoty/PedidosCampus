              "raw": "{\n  \"pedido_id\": \"{{pedidoId}}\",\n  \"repartidor_id\": \"{{repartidorId}}\",\n  \"estrellas\": 5,\n  \"comentario\": \"Entrega rápida y cuidadosa, muy profesional\"\n}"
