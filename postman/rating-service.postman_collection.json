              "raw": "{{baseUrl}}/ratings/delivery/delivery/{{repartidorId}}?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["ratings", "delivery", "delivery", "{{repartidorId}}"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "05 - Actualizar calificación",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estrellas\": 4,\n  \"comentario\": \"Buena entrega, aunque llegó 5 minutos tarde\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ratings/delivery/{{ratingDeliveryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ratings", "delivery", "{{ratingDeliveryId}}"]
            }
          }
        },
        {
          "name": "06 - Obtener estadísticas del repartidor",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ratings/stats/delivery/{{repartidorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ratings", "stats", "delivery", "{{repartidorId}}"]
            }
          }
        },
        {
          "name": "07 - Eliminar calificación",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ratings/delivery/{{ratingDeliveryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["ratings", "delivery", "{{ratingDeliveryId}}"]
            }
          }
        }
      ]
    }
  ]
}
