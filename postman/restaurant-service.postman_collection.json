  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/docs",
              "host": ["{{BASE_URL}}"],
              "path": ["docs"]
            }
          }
        }
      ]
    },
    {
      "name": "Restaurantes - Public Operations",
      "item": [
        {
          "name": "1. List Restaurants (Public, with filters)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{PUBLIC_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants?categoria=&is_active=true&q=&limit=50&offset=0",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "restaurants"],
              "query": [
                {
                  "key": "categoria",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true"
                },
                {
                  "key": "q",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "2. Get Restaurant Detail (Public, with menu)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{PUBLIC_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}?include_unavailable=false",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "restaurants", "{{restaurante_id}}"],
              "query": [
                {
                  "key": "include_unavailable",
                  "value": "false"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Restaurantes - Admin Operations",
      "item": [
        {
          "name": "1. Create Restaurant (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"La Pizzería del Barrio\",\n  \"descripcion\": \"Auténtica pizzería italiana con ingredientes frescos\",\n  \"categoria\": \"pizza\",\n  \"telefono\": \"+34912345678\",\n  \"email\": \"info@lapizzeria.es\",\n  \"direccion\": \"Calle Principal 42, Madrid\",\n  \"horario_apertura\": \"11:00\",\n  \"horario_cierre\": \"23:00\",\n  \"imagen_url\": \"https://example.com/pizzeria.jpg\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "restaurants"]
            }
          }
        },
        {
          "name": "2. Update Restaurant (Admin only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"La Pizzería del Barrio - Actualizado\",\n  \"descripcion\": \"Auténtica pizzería italiana con ingredientes frescos y horno de leña\",\n  \"horario_apertura\": \"10:00\",\n  \"horario_cierre\": \"00:00\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "restaurants", "{{restaurante_id}}"]
            }
          }
        },
        {
          "name": "3. Activate Restaurant (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}/activate",
              "host": ["{{BASE_URL}}"],
              "path": [
                "api",
                "v1",
                "restaurants",
                "{{restaurante_id}}",
                "activate"
              ]
            }
          }
        },
        {
          "name": "4. Deactivate Restaurant (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}/deactivate",
              "host": ["{{BASE_URL}}"],
              "path": [
                "api",
                "v1",
                "restaurants",
                "{{restaurante_id}}",
                "deactivate"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Productos - Public Operations",
      "item": [
        {
          "name": "1. List Products by Restaurant (Public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{PUBLIC_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}/products?disponible=true&limit=100&offset=0",
              "host": ["{{BASE_URL}}"],
              "path": [
                "api",
                "v1",
                "restaurants",
                "{{restaurante_id}}",
                "products"
              ],
              "query": [
                {
                  "key": "disponible",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "100"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "2. Get Product Detail (Public)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{PUBLIC_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/{{producto_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products", "{{producto_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos - Admin Operations",
      "item": [
        {
          "name": "1. Create Product (Admin only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pizza Margherita\",\n  \"descripcion\": \"Clásica pizza italiana con tomate, mozzarella y albahaca\",\n  \"precio\": 12.99,\n  \"categoria\": \"pizza\",\n  \"imagen_url\": \"https://example.com/margherita.jpg\",\n  \"disponible\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/restaurants/{{restaurante_id}}/products",
              "host": ["{{BASE_URL}}"],
              "path": [
                "api",
                "v1",
                "restaurants",
                "{{restaurante_id}}",
                "products"
              ]
            }
          }
        },
        {
          "name": "2. Update Product (Admin only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Pizza Margherita Premium\",\n  \"precio\": 14.99,\n  \"disponible\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/{{producto_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products", "{{producto_id}}"]
            }
          }
        },
        {
          "name": "3. Delete Product (Admin only - soft delete)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/{{producto_id}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products", "{{producto_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos - Batch Operations (Internal)",
      "item": [
        {
          "name": "1. Validate Products Batch (Order Service Integration)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{PUBLIC_TOKEN}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 2,\n      \"precio_unit\": 12.99\n    },\n    {\n      \"producto_id\": \"<otro_producto_id>\",\n      \"cantidad\": 1,\n      \"precio_unitario\": 8.50\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/validate-batch",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products", "validate-batch"]
            }
          }
        }
      ]
    },
