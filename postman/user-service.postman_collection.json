    {
      "name": "4️⃣ Internal Endpoints (via Gateway)",
      "description": "⚠️ These endpoints should ONLY be called by the API Gateway and order-service.\n\nIn development, you can test them with a mock JWT containing an internal/gateway claim.",
      "item": [
        {
          "name": "GET /profiles/delivery - List Available Delivery Persons",
          "description": "Get list of available delivery persons (repartidores) with optional geolocation filtering.\n\n**Auth**: Required (internal/gateway only)\n**Query Params**:\n- limit: number (default 10)\n- offset: number (default 0)\n- near: 'lat,lon' e.g. '40.4168,-3.7038' (optional, for Madrid)\n- radius: number in meters (optional, default 5000)\n- onlyAvailable: true/false (default true)\n\n**Status**: 200 OK with list of repartidor profiles",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('jwt_token') || 'NO_TOKEN_SET';",
                  "pm.request.headers.add({",
                  "  key: 'Authorization',",
                  "  value: 'Bearer ' + token",
                  "});",
                  "// In real environment, would add x-client: gateway header",
                  "pm.request.headers.add({",
                  "  key: 'x-client',",
                  "  value: 'gateway'",
                  "});",
                  "console.log('🔐 JWT + gateway header added');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/profiles/delivery?limit=10&offset=0&onlyAvailable=true",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles", "delivery"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "onlyAvailable",
                  "value": "true"
                },
                {
                  "key": "near",
                  "value": "40.4168,-3.7038",
                  "disabled": true
                },
                {
                  "key": "radius",
                  "value": "5000",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
