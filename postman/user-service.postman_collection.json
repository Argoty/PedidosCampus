    {
      "name": "4️⃣ Internal Endpoints (via Gateway)",
      "description": "⚠️ These endpoints should ONLY be called by the API Gateway.\n\nIn development, tests with X-Client: gateway header.",
      "item": [
        {
          "name": "GET /profiles/delivery - List Available Delivery Persons",
          "description": "Get list of available delivery persons.\n\n**Auth**: Required + X-Client: gateway header\n**Status**: 200 OK",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const token = pm.environment.get('jwt_token') || 'NO_TOKEN_SET';",
                  "pm.request.headers.add({key: 'Authorization', value: 'Bearer ' + token});",
                  "pm.request.headers.add({key: 'x-client', value: 'gateway'});",
                  "console.log('🔐 JWT + gateway header added');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/profiles/delivery?limit=10&offset=0&onlyAvailable=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "profiles", "delivery"],
              "query": [
                {"key": "limit", "value": "10"},
                {"key": "offset", "value": "0"},
                {"key": "onlyAvailable", "value": "true"}
              ]
            }
          },
          "response": []
        },
