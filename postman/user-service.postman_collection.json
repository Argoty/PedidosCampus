      "name": "📚 Quick Reference",
      "description": "API Documentation and error codes",
      "item": [
        {
          "name": "Error Response Codes",
          "description": "**400 INVALID_REQUEST** - Validation failed\n**401 UNAUTHORIZED** - No JWT or invalid token\n**403 FORBIDDEN** - Insufficient permissions (role mismatch)\n**404 NOT_FOUND** - Resource not found\n**409 CONFLICT** - Resource already exists or operation conflicts\n**500 INTERNAL_ERROR** - Server error",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000"
            }
          },
          "response": []
        }
