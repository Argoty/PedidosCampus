// Microservicio: Restaurantes (PostgreSQL)
// Alcance: restaurantes y menú de productos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("RESTAURANTES_DATABASE_URL")
}

model Restaurante {
  id          String     @id @default(uuid()) @db.Uuid
  nombre      String
  descripcion String?
  direccion   String
  categoria   String
   imagenUrl   String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  productos Producto[]

  @@index([categoria])
  @@index([isActive])
  @@map("restaurantes")
}

model Producto {
  id             String      @id @default(uuid()) @db.Uuid
  restauranteId  String      @db.Uuid
  nombre         String
  descripcion    String?
  precio         Decimal     @db.Decimal(10, 2)
  disponible     Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurante Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)

  @@index([restauranteId])
  @@index([disponible])
  @@map("productos")
}
